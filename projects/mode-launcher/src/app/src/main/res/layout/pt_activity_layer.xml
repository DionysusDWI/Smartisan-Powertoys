<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ 图层管理页（任务 AP / AP6）。

  版式：顶部栏 → 触摸冲突提示（有冲突才出现）→ 按屏分组的图层列表 → 底部实测统计。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pt_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/layerToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/pt_bg"
        app:navigationIcon="@drawable/ic_pt_back"
        app:title="@string/pt_layer_title"
        app:titleTextColor="@color/pt_ink" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp"
        android:text="@string/pt_layer_subtitle"
        android:textColor="@color/pt_ink_faint"
        android:textSize="12sp" />

    <!-- ★ 触摸冲突 —— 只在真的有两个"自吃"图层叠在一起时才出现 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/conflictBox"
        style="@style/PtCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FFF6E8"
        app:strokeColor="@color/pt_accent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pt_layer_conflict_header"
                android:textColor="@color/pt_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/pt_ink_soft"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/conflictLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/pt_ink"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="两个「自吃」图层的矩形相交时，上面那层会吃掉下面那层的点击。"
                android:textColor="@color/pt_ink_faint"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/layerList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/layerEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/pt_layer_empty"
        android:textColor="@color/pt_ink_faint"
        android:textSize="13sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/pt_outline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/layerStat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/pt_ink_faint"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLayerRefresh"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/pt_action_refresh"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
