<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ MOD：性能模式（任务 AK）—— 契约见 :app 的 com.shware.mode.mod.ModContract。

  ## 它是什么

  把 **QTI perf HAL 的 `perfLockAcquire`** 封装成一个开关：开启后 **CPU 频率下限被抬起**
  （实测空闲时大核 710400→1804800、超大核 825600→2956800；突发负载纯计算快 19.3%）。

  ## ★ 为什么【不需要】root / Shizuku / 特殊权限

  走的是 `vendor.perfservice` 的 binder，而且**全程只用公开 API**：
  `Parcel` 拼包 + `IBinder.transact` —— **只有 `ServiceManager.getService` 一处要反射**。

  ⇒ 本 APK 里**没有任何 uses-permission**（除了前台服务所需的那两条）。

  ## 三道安全闸门（见 PerfModeEngine）

  自动过期 ／ 过热兜底 ／ ★★ **崩溃自愈**（锁只有 45 秒寿命 + 每 15 秒续期）
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ★ 快捷开关磁贴（这是普通权限，声明即得；用户仍需手动把磁贴拖进面板） -->
    <uses-permission android:name="android.permission.BIND_QUICK_SETTINGS_TILE" />

    <application
        android:allowBackup="true"
        android:label="性能模式"
        android:supportsRtl="true">

        <service
            android:name=".PerfModeService"
            android:process=":mod_perfmode"
            android:exported="true"
            android:label="性能模式"
            android:foregroundServiceType="specialUse">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="MODE launcher mod: QTI perf lock controller" />

            <intent-filter>
                <action android:name="com.shware.mode.action.MOD" />
            </intent-filter>

            <meta-data android:name="com.shware.mode.MOD_API"    android:value="1" />
            <meta-data android:name="com.shware.mode.MOD_ID"     android:value="perf.mode" />
            <meta-data android:name="com.shware.mode.MOD_NAME"   android:value="性能模式" />
            <meta-data android:name="com.shware.mode.MOD_DESC"   android:value="抬起 CPU 频率下限（QTI perf HAL，免 root）" />
            <meta-data android:name="com.shware.mode.MOD_TARGET" android:value="phone" />
            <!-- 本 mod 不画卡片 ⇒ 申报 none 也不影响（宿主读的是"要不要收触摸"） -->
            <meta-data android:name="com.shware.mode.MOD_TOUCH"  android:value="none" />
            <meta-data android:name="com.shware.mode.MOD_SETTINGS" android:value=".SettingsActivity" />
            <!-- ★ 图形化 UI 用的可选申报（任务 AP）—— 不写也有合理默认 -->
            <meta-data android:name="com.shware.mode.MOD_CATEGORY" android:value="performance" />
            <meta-data android:name="com.shware.mode.MOD_ORDER"    android:value="10" />
            <meta-data android:name="com.shware.mode.MOD_ICON"     android:value="feat_perfmode" />
            <meta-data android:name="com.shware.mode.MOD_ENABLED_BY_DEFAULT" android:value="false" />
        </service>

        <!-- ★★★★ 快捷开关磁贴（任务 AK8）—— 下拉通知栏点一下开关
             ⚠️ Android 不允许应用自己添加磁贴，用户要在「快捷设置」编辑界面手动拖出来 -->
        <service
            android:name=".PerfModeTileService"
            android:process=":mod_perfmode"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_manage"
            android:label="性能模式"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- 让磁贴默认出现在「可添加」列表里 -->
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="false" />
        </service>

        <!-- ★ 广播入口：给 Tasker / 自动化用；也是通知栏按钮的后端 -->
        <receiver
            android:process=":mod_perfmode"
            android:name=".ToggleReceiver"
            android:exported="true"
            android:label="性能模式开关">
            <intent-filter>
                <action android:name="com.shware.mode.mod.perfmode.TOGGLE" />
            </intent-filter>
        </receiver>

        <activity
            android:process=":mod_perfmode"
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="性能模式"
            android:launchMode="singleTop">
        </activity>

    </application>

</manifest>
